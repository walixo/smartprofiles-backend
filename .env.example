# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
# 4000 is left free deliberately — the MentorYou backend on this machine uses it.
PORT=4100

# Mongo connection string (local default shown).
MONGODB_URI=mongodb://127.0.0.1:27017/smart-profiles

# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Origin of the Vite dev server, used for logging and future CORS needs.
CLIENT_ORIGIN=http://localhost:5173
